# ═══════════════════════════════════════════════════════════════════════
# PULSECHECK HR PORTAL — DOCKER COMPOSE CONFIGURATION FILE (.env)
# ═══════════════════════════════════════════════════════════════════════

# Network Binding Configuration
# - Set BIND_IP=0.0.0.0 to listen on all VM network interfaces (default, recommended)
# - Or set BIND_IP to a specific network interface IP on your VM (e.g., 192.168.1.150)
BIND_IP=0.0.0.0

# Application Port on your VM host
# Change this if port 3000 is occupied (e.g., 80, 8080, 3000)
APP_PORT=3000

# Security: JWT Token Secret Key (Change this in production)
JWT_SECRET=pulsecheck_super_secret_jwt_key_2026

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pulsecheck
DB_PORT=5432
